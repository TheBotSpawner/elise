# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Public base URL of the app (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...), which replaces the legacy service_role key. Bypasses RLS; never expose it to the browser.
SUPABASE_SECRET_KEY=

# AI runtime (server-only)
OPENAI_API_KEY=

# Trigger.dev (server-only)
TRIGGER_SECRET_KEY=
