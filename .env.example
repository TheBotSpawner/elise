# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# REQUIRED: the three Supabase values (accounts and data) — /api/health answers 503 without them.
# Everything else is optional: a missing or malformed value disables only its own feature
# (e.g. no Notion secret → Notion can't be connected; everything else works).

# development | staging | production (tags logs; separates environments)
ELISE_ENV=development

# Public base URL of the app, used for auth redirects (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Supabase (Project Settings → API Keys). Required for accounts and data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Used only by the encrypted credential store
# and to create connections after a verified OAuth callback. Bypasses RLS: never expose it.
SUPABASE_SECRET_KEY=

# AI runtime (server-only). Without a key, chat explains that AI is not configured.
OPENAI_API_KEY=
# AI profiles (ADR-025, docs/performance): "model[:effort[:serviceTier]]". Business logic asks for
# a profile, never a model. Unset → benchmarked defaults: fast/standard/background gpt-6-luna:low,
# deep gpt-6-luna:medium. ":fast" turns on Fast mode (priority processing, 2x price) per profile.
AI_PROFILE_FAST=
AI_PROFILE_STANDARD=
AI_PROFILE_DEEP=
AI_PROFILE_BACKGROUND=
# Chat routing: adaptive (fast/deep per request, relevant tools, rest on demand) or legacy (every
# turn on the standard profile with all tools). The previous setup, for comparison:
#   ELISE_AI_ROUTING=legacy ELISE_TOOL_SELECTION=all AI_PROFILE_STANDARD=gpt-5-mini
ELISE_AI_ROUTING=adaptive
ELISE_TOOL_SELECTION=selected
# Voice runtime (ADR-026): legacy (STT → ELISE → TTS) or live (GPT-Live over WebRTC, ELISE as the
# backend via client delegation; $0.05/min of open session). `?voice=live|legacy` compares on Home.
VOICE_RUNTIME=legacy
# Knowledge embeddings (1536 dimensions are stored). Changing it needs a reindex.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Voice (ADR-014): speech-to-text and streamed text-to-speech. Optional; these are the defaults.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Spoken replies (ADR-030): "openai" (current) or "elevenlabs" (falls back to openai per segment).
SPEECH_PROVIDER=openai
# Server-only ElevenLabs credentials: never NEXT_PUBLIC_, never sent to the browser.
ELEVENLABS_API_KEY=
# The "ELISE" voice (and an optional alternative), from your ElevenLabs voices.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_ALT=
# eleven_v4_turbo (Text to Dialogue WebSocket) or an HTTP model such as eleven_flash_v2_5.
ELEVENLABS_MODEL_ID=eleven_v4_turbo
# Web search (ADR-015). Default: OpenAI hosted web search with the key above.
# Set TAVILY_API_KEY to use Tavily (faster, built for agents); WEB_SEARCH_PROVIDER forces one.
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini
TAVILY_API_KEY=
WEB_SEARCH_PROVIDER=
# Location + Maps (ADR-023), optional. Two separate Google Maps Platform keys:
# - Server key (secret): API restrictions = Places API (New), Routes API, Geocoding API;
#   application restriction = your server's egress IPs when you have them. Never NEXT_PUBLIC.
#   Development only: if unset, ELISE tries the browser key below; Google rejects it while that
#   key has a website (HTTP referrer) restriction, and ELISE says so instead of failing silently.
GOOGLE_MAPS_SERVER_API_KEY=

# Weather (ADR-038), optional. Without a key ELISE uses the free Open-Meteo API, which its terms
# allow for non-commercial use only; a commercial deployment needs a subscription key.
OPEN_METEO_API_KEY=

# OCR for scanned PDFs and images (ADR-035), optional. Google Document AI:
# 1. Enable "Cloud Document AI API" (documentai.googleapis.com) in a project with billing.
# 2. Document AI › Processor gallery › "Enterprise Document OCR" › create (region "us" or "eu").
#    Copy its resource name: projects/PROJECT_ID/locations/us/processors/PROCESSOR_ID.
# 3. IAM › Service accounts › create one with role "Document AI API User"
#    (roles/documentai.apiUser) › Keys › add JSON key. Paste the JSON (or its base64) below.
# Server only, never NEXT_PUBLIC. ~US$1.50 per 1,000 pages; native-text pages are never OCR'd.
GOOGLE_DOCUMENT_AI_PROCESSOR=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google connections (Calendar, Tasks, Gmail). OAuth "Web application" client from Google Cloud.
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/connections/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Notion (Knowledge + Structured databases): one public integration (notion.so/profile/integrations).
# Capabilities: Read content, Update content, Insert content. No comments; user info without email.
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/connections/notion/callback
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Encrypts OAuth credentials at rest (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it without setting the old value as ELISE_ENCRYPTION_KEY_PREVIOUS first.
ELISE_ENCRYPTION_KEY=
ELISE_ENCRYPTION_KEY_PREVIOUS=

# Chat requests per user per minute.
CHAT_RATE_LIMIT_PER_MINUTE=20

# Trigger.dev: background execution for Schedules / Morning Brief, Knowledge ingestion and sync,
# Recall indexing, Finance imports and bulk database changes. Without it those show as
# "couldn't start" with a retry; interactive chat and voice keep working.
# Secret key per environment (dashboard -> API keys): tr_dev_... locally, tr_prod_... in production.
TRIGGER_SECRET_KEY=
# Optional: overrides the project ref in trigger.config.ts.
TRIGGER_PROJECT_REF=

# ── Productization (ADR-019) ────────────────────────────────────────────────
# Comma-separated emails that may open the internal usage page (/admin/usage). Empty: nobody.
ELISE_ADMIN_EMAILS=
# Feature flag overrides (src/config/flags.ts): "name:on", "name:off" or "name:ws=<id>;<id>".
# Flags: wakePhrase, research, study, usagePage. Example: ELISE_FLAGS=wakePhrase:off
ELISE_FLAGS=

# Location + Maps (ADR-023), browser side.
# - Browser key (public by design): API restriction = Maps JavaScript API only; application
#   restriction = HTTP referrers (your app's origins, e.g. https://app.example.com/*,
#   http://localhost:3000/*). Without it, places and routes show as lists, no map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (vector map, required for Advanced Markers). Empty in development uses DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Music (ADR-042). Spotify: create an app at developer.spotify.com/dashboard (Web API + Web
# Playback SDK). Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/connections/spotify/callback
# — HTTPS, or http://127.0.0.1:PORT locally (Spotify rejects "localhost"). Development mode:
# the app owner needs Premium and at most 5 allow-listed users; playback needs Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: only when the redirect differs from {NEXT_PUBLIC_APP_URL}/api/connections/spotify/callback
SPOTIFY_REDIRECT_URI=
# YouTube Data API v3 key (Google Cloud console), restricted to the YouTube Data API. Search only.
YOUTUBE_API_KEY=
