# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# REQUIRED: the three Supabase values (accounts and data) — /api/health answers 503 without them.
# Everything else is optional: a missing or malformed value disables only its own feature
# (e.g. no Notion secret → Notion can't be connected; everything else works).

# development | staging | production (tags logs; separates environments)
ELISE_ENV=development

# Public base URL of the app, used for auth redirects (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Supabase (Project Settings → API Keys). Required for accounts and data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Used only by the encrypted credential store
# and to create connections after a verified OAuth callback. Bypasses RLS: never expose it.
SUPABASE_SECRET_KEY=

# AI runtime (server-only). Without a key, chat explains that AI is not configured.
OPENAI_API_KEY=
# AI profiles (ADR-025, docs/performance): "model[:effort[:serviceTier]]". Business logic asks for
# a profile, never a model. Unset → benchmarked defaults: fast/standard/background gpt-6-luna:low,
# deep gpt-6-luna:medium. ":fast" turns on Fast mode (priority processing, 2x price) per profile.
AI_PROFILE_FAST=
AI_PROFILE_STANDARD=
AI_PROFILE_DEEP=
AI_PROFILE_BACKGROUND=
# Chat routing: adaptive (fast/deep per request, relevant tools, rest on demand) or legacy (every
# turn on the standard profile with all tools). The previous setup, for comparison:
#   ELISE_AI_ROUTING=legacy ELISE_TOOL_SELECTION=all AI_PROFILE_STANDARD=gpt-5-mini
ELISE_AI_ROUTING=adaptive
ELISE_TOOL_SELECTION=selected
# Prices (USD per 1M tokens) for models src/config/pricing.ts doesn't list. Verify them on the
# provider's pricing page. Memory learning only runs on a model with a known price.
#   AI_MODEL_PRICES={"gpt-6-luna":{"input":0.1,"cached":0.01,"output":0.5}}
AI_MODEL_PRICES=
# Voice runtime (ADR-026): legacy (STT → ELISE → TTS) or live (GPT-Live over WebRTC, ELISE as the
# backend via client delegation; $0.05/min of open session). `?voice=live|legacy` compares on Home.
VOICE_RUNTIME=legacy
# Knowledge embeddings (1536 dimensions are stored). Changing it needs a reindex.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Voice (ADR-014): speech-to-text and streamed text-to-speech. Optional; these are the defaults.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Spoken replies (ADR-030): "openai" (current) or "elevenlabs" (falls back to openai per segment).
SPEECH_PROVIDER=openai
# Server-only ElevenLabs credentials: never NEXT_PUBLIC_, never sent to the browser.
ELEVENLABS_API_KEY=
# ELISE curated ElevenLabs voices (ADR-030). Server-only: never expose these ids to the client.
# 1 = ELISE (default), 2 = Martín, 3 = Adriana. A missing 2 or 3 just isn't offered.
ELEVENLABS_VOICE_ID_1=
ELEVENLABS_VOICE_ID_2=
ELEVENLABS_VOICE_ID_3=
# Legacy single voice: used for ELISE only when ELEVENLABS_VOICE_ID_1 is empty.
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo (Text to Dialogue WebSocket) or an HTTP model such as eleven_flash_v2_5.
ELEVENLABS_MODEL_ID=eleven_v4_turbo
# Web search (ADR-015). Default: OpenAI hosted web search with the key above.
# Set TAVILY_API_KEY to use Tavily (faster, built for agents); WEB_SEARCH_PROVIDER forces one.
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini
TAVILY_API_KEY=

# Mercado Libre official API (ADR-112). Off until the application is approved for this use:
# keep MERCADOLIBRE_API_ENABLED=false. Without it ELISE shows Mercado Libre listings found by
# web search (title and link, no price) and a "Buscar en Mercado Libre" link.
MERCADOLIBRE_API_ENABLED=false
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
# Bootstrap only: the live refresh token is kept encrypted in app_credentials after
# `scripts/mercadolibre-connect.ts connect` (it rotates on every use). Leave empty.
MERCADOLIBRE_REFRESH_TOKEN=
# The redirect URI registered in Mercado Libre Developers, exactly (https).
MERCADOLIBRE_REDIRECT_URI=
WEB_SEARCH_PROVIDER=
# Smart Life / Tuya (ADR-118, ADR-119). Off by default. ELISE's Tuya cloud project, server-only
# (never NEXT_PUBLIC_): Access ID / Access Secret from the project's Overview.
TUYA_ENABLED=false
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# Each person connects their OWN account on Tuya's official H5 page. One link per data center,
# exactly as Tuya's console shows it after "Devices → Link App Account → Configure OAuth 2.0
# Authorization" (callback: https://<ELISE>/api/connections/tuya/callback/<us|us-e|eu|eu-w|in|sg|cn>).
# Only data centers with a link are offered.
TUYA_OAUTH_URL_US=
TUYA_OAUTH_URL_US_E=
TUYA_OAUTH_URL_EU=
TUYA_OAUTH_URL_EU_W=
TUYA_OAUTH_URL_IN=
TUYA_OAUTH_URL_SG=
TUYA_OAUTH_URL_CN=
# Local check script only (scripts/tuya-check.ts), never used by the app: an account linked in
# the console's "Link App Account" and its data center.
TUYA_REGION=us
TUYA_DEV_UID=
# Real images (ADR-120). Wikimedia Commons: free, no key (on). Openverse: free, no key, slow
# (off). Places photos: billed per use on the Maps key below (off until approved).
IMAGES_COMMONS_ENABLED=true
IMAGES_OPENVERSE_ENABLED=false
IMAGES_PLACES_ENABLED=false
# Location + Maps (ADR-023), optional. Two separate Google Maps Platform keys:
# - Server key (secret): API restrictions = Places API (New), Routes API, Geocoding API;
#   application restriction = your server's egress IPs when you have them. Never NEXT_PUBLIC.
#   Development only: if unset, ELISE tries the browser key below; Google rejects it while that
#   key has a website (HTTP referrer) restriction, and ELISE says so instead of failing silently.
GOOGLE_MAPS_SERVER_API_KEY=

# Weather (ADR-038), optional. Without a key ELISE uses the free Open-Meteo API, which its terms
# allow for non-commercial use only; a commercial deployment needs a subscription key.
OPEN_METEO_API_KEY=
# Market data (ADR-074): Financial Modeling Prep, server-only (never NEXT_PUBLIC_). Needed in
# .env.local, the Vercel server environment AND Trigger.dev (scheduled briefs read quotes from
# the background worker). Unset: no market tools and no Markets block.
FMP_API_KEY=
# ELISE Desktop downloads (ADR-084), web/Vercel: one URL per channel, set ONCE ({channel} →
# beta/stable); the release workflow rewrites the file, never this value.
# ELISE_DESKTOP_MANIFEST_URL=https://github.com/TheBotSpawner/elise/releases/download/desktop-{channel}/desktop-releases.json
# Production shows beta (unsigned) only to ELISE_ADMIN_EMAILS; optional override: stable | beta.
ELISE_DESKTOP_MANIFEST_URL=
ELISE_DESKTOP_DOWNLOAD_CHANNEL=

# ELISE Desktop build-time configuration (ADR-081/084). Baked into the installer (public values
# only): change them → build again. A packaged build FAILS without a non-local https
# ELISE_CLOUD_URL. In CI these come from Actions Variables; locally from here.
ELISE_CLOUD_URL=
ELISE_UPDATE_FEED=https://github.com/TheBotSpawner/elise/releases/download
ELISE_DESKTOP_CHANNEL=stable
# Development only: the local Home Assistant ELISE Desktop's runtime talks to, until the
# managed runtime exists (docs/engineering/27-elise-desktop.md). Never commit a real token.
ELISE_HA_URL=
HA_TOKEN=

# OCR for scanned PDFs and images (ADR-035), optional. Google Document AI:
# 1. Enable "Cloud Document AI API" (documentai.googleapis.com) in a project with billing.
# 2. Document AI › Processor gallery › "Enterprise Document OCR" › create (region "us" or "eu").
#    Copy its resource name: projects/PROJECT_ID/locations/us/processors/PROCESSOR_ID.
# 3. IAM › Service accounts › create one with role "Document AI API User"
#    (roles/documentai.apiUser).
# 4. Authentication, one of (ADR-121):
#    - Vercel: Workload Identity Federation (no keys) — the four GCP_* identifiers below.
#    - Trigger.dev jobs: OCR_TOKEN_BROKER_URL ({NEXT_PUBLIC_APP_URL}/api/internal/ocr-token),
#      requests signed with OCR_BROKER_SECRET: the same random value (>= 32 chars) in Vercel
#      and Trigger.dev, e.g.
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#    - Only if your organization allows keys: the JSON key (or its base64) in
#      GOOGLE_SERVICE_ACCOUNT_JSON.
# Server only, never NEXT_PUBLIC. ~US$1.50 per 1,000 pages; native-text pages are never OCR'd.
GOOGLE_DOCUMENT_AI_PROCESSOR=
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
OCR_TOKEN_BROKER_URL=
OCR_BROKER_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google connections (Calendar, Tasks, Gmail). OAuth "Web application" client from Google Cloud.
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/connections/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft (Outlook Mail, ADR-058). Entra app registration, delegated permissions only.
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/connections/microsoft/callback
# Setup: docs/engineering/24-microsoft-setup.md. Tenant: common (default) | organizations | consumers | <id>
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=

# Slack (team messaging, ADR-062): one Slack app (OAuth v2, user token scopes only).
# Redirect URL to register (HTTPS only): {NEXT_PUBLIC_APP_URL}/api/connections/slack/callback
# Setup and app manifest: docs/engineering/25-slack-setup.md. Tokens are never env vars: each
# workspace's OAuth tokens are stored encrypted in the database. Also set these on Trigger.dev.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Only for an unlisted distributed app (Real-time Search not allowed): legacy search fallback.
SLACK_LEGACY_SEARCH=

# Notion (Knowledge + Structured databases): one public integration (notion.so/profile/integrations).
# Capabilities: Read content, Update content, Insert content. No comments; user info without email.
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/connections/notion/callback
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Encrypts OAuth credentials at rest (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it without setting the old value as ELISE_ENCRYPTION_KEY_PREVIOUS first.
ELISE_ENCRYPTION_KEY=
ELISE_ENCRYPTION_KEY_PREVIOUS=

# Native memory (ADR-107). "on" lets each person opt in to learning from their conversations
# (Settings › Memoria); off by default. Hard monthly caps, USD, for background memory work.
# Set the same values on Vercel and on Trigger.dev (the learning jobs run there).
MEMORY_LEARNING=off
MEMORY_USER_MONTHLY_USD=0.5
MEMORY_WORKSPACE_MONTHLY_USD=
# Keys the do-not-relearn hashes of forgotten facts. Default: derived from ELISE_ENCRYPTION_KEY.
# Changing it makes earlier "forget" fingerprints stop matching.
MEMORY_FINGERPRINT_KEY=

# Chat requests per user per minute.
CHAT_RATE_LIMIT_PER_MINUTE=20

# Trigger.dev: background execution for Schedules / Morning Brief, Knowledge ingestion and sync,
# Recall indexing, Finance imports and bulk database changes. Without it those show as
# "couldn't start" with a retry; interactive chat and voice keep working.
# Secret key per environment (dashboard -> API keys): tr_dev_... locally, tr_prod_... in production.
TRIGGER_SECRET_KEY=
# Optional: overrides the project ref in trigger.config.ts.
TRIGGER_PROJECT_REF=

# ── Productization (ADR-019) ────────────────────────────────────────────────
# Comma-separated emails that may open the internal usage page (/admin/usage). Empty: nobody.
ELISE_ADMIN_EMAILS=
# Feature flag overrides (src/config/flags.ts): "name:on", "name:off" or "name:ws=<id>;<id>".
# Flags: wakePhrase, research, study, usagePage. Example: ELISE_FLAGS=wakePhrase:off
ELISE_FLAGS=

# Location + Maps (ADR-023), browser side.
# - Browser key (public by design): API restriction = Maps JavaScript API only; application
#   restriction = HTTP referrers (your app's origins, e.g. https://app.example.com/*,
#   http://localhost:3000/*). Without it, places and routes show as lists, no map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (vector map, required for Advanced Markers). Empty in development uses DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# ELISE Desktop's own browser key (ADR-104), read when building the installer: Desktop loads
# from elise-app://app/, which the web key's HTTP-referrer restriction refuses. Application
# restriction = None (the key ships inside the app); API restriction = Maps JavaScript API only;
# a daily quota in Google Cloud. Empty: Desktop uses NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
ELISE_DESKTOP_GOOGLE_MAPS_API_KEY=

# Music (ADR-042). Spotify: create an app at developer.spotify.com/dashboard (Web API + Web
# Playback SDK). Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/connections/spotify/callback
# — HTTPS, or http://127.0.0.1:PORT locally (Spotify rejects "localhost"). Development mode:
# the app owner needs Premium and at most 5 allow-listed users; playback needs Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: only when the redirect differs from {NEXT_PUBLIC_APP_URL}/api/connections/spotify/callback
SPOTIFY_REDIRECT_URI=
# YouTube Data API v3 key (Google Cloud console), restricted to the YouTube Data API. Search only.
YOUTUBE_API_KEY=
